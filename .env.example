# Supabase — use the service role key so the server can write to the DB
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The deployed web app URL (no trailing slash)
APP_URL=https://primestatus.site

# Shared secret — set the same value in:
#   1. Railway env vars (GENERATION_SECRET)
#   2. Expo env vars    (EXPO_PUBLIC_GENERATION_SECRET)
#   3. Supabase webhook header: Authorization: Bearer <value>
GENERATION_SECRET=change-me-to-a-long-random-string

# Simple bearer token the Supabase webhook must send in the Authorization header
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Fly.io sets this automatically — leave as 3000 for local dev
PORT=3000
